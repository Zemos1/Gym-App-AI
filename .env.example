# OpenAI API Key (optional - enables AI-powered workout generation & journal analysis)
# Without this, the app uses local/offline plan generation
# Get your key: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-your-key-here

# Supabase Configuration (required for auth & data persistence)
# Get credentials: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
